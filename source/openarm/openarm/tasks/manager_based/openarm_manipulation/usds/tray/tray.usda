#usda 1.0
(
    defaultPrim = "Tray"
    metersPerUnit = 1.0
    upAxis = "Z"
    doc = "Bimanual lift tray: a single FLAT board (one rigid body). The two short ends overhang the central stand, so a parallel-jaw gripper can approach each end from the side, slide one finger UNDER the overhang and one over the top, and clamp the board -> form-closure grasp that the bottom finger physically supports while lifting (does not rely on friction alone). Vertices are fully BAKED to tray-local coordinates (size baked in, NO xformOp) so the USD importer cannot drop scale/translate."
)

# ─────────────────────────────────────────────────────────────────────
# Tray-local frame: origin at board centre, long axis +Y.
#   board  full 0.36 (X) × 0.50 (Y) × 0.030 (Z)   centre (0, 0, 0)
# Resting on the 0.24 m-wide stand (|Y| ≤ 0.12), the board ends from
# |Y| = 0.12 out to |Y| = 0.25 hang in free air -> a finger fits under them.
# Side-grasp target: tray-local (0, ±0.23, 0)  ==> HALF_GRASP_Y = 0.23,
# GRASP_Z_OFFSET = 0.0 (board mid-thickness).  Board is 30 mm thick, well
# inside the 88 mm parallel-jaw span so the jaws sandwich it top/bottom.
# These numbers MUST match HALF_GRASP_Y / GRASP_Z_OFFSET / DECK_* in lift_env_cfg.py.
#
# Box face topology (6 outward quads), point order:
#   0(-x,-y,-z) 1(+x,-y,-z) 2(+x,+y,-z) 3(-x,+y,-z)
#   4(-x,-y,+z) 5(+x,-y,+z) 6(+x,+y,+z) 7(-x,+y,+z)
# ─────────────────────────────────────────────────────────────────────

def Xform "Tray" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
)
{
    float physics:mass = 0.5

    # High-friction material so the clamped board does not slip while lifting.
    def Material "TrayPhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1.0
        float physics:staticFriction = 1.2
        float physics:restitution = 0.0
    }

    def Mesh "deck" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Tray/TrayPhysicsMaterial>
        uniform token physics:approximation = "convexHull"
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [4, 5, 6, 7,  0, 3, 2, 1,  0, 1, 5, 4,  2, 3, 7, 6,  0, 4, 7, 3,  1, 2, 6, 5]
        point3f[] points = [
            (-0.18, -0.25, -0.015), (0.18, -0.25, -0.015), (0.18, 0.25, -0.015), (-0.18, 0.25, -0.015),
            (-0.18, -0.25, 0.015), (0.18, -0.25, 0.015), (0.18, 0.25, 0.015), (-0.18, 0.25, 0.015)
        ]
        float3[] extent = [(-0.18, -0.25, -0.015), (0.18, 0.25, 0.015)]
        color3f[] primvars:displayColor = [(0.82, 0.66, 0.36)]
        uniform token subdivisionScheme = "none"
    }
}
